      <div class="mi-nav-mobile">
        <img src="/images/medimpact/mobile/mobile/navigation-top-bar-menu-transparent.png" alt="MedImpact mobile top navigation bar" loading="lazy" />
        <img src="/images/medimpact/mobile/mobile/navigation-footer-menu-03.png" alt="MedImpact mobile footer menu" loading="lazy" />
      </div>
    </div>
  </SectionContent>

