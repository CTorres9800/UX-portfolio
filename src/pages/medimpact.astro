import miflowLegend from '../assets/flows/mi-flow-legend.svg?raw';
const miFlowSvgs = [miflow1, miflow2, miflow3, miflow4, miflow5];
// Survey results rendered as Google-Forms-style pie charts (each question totals 100%).
const miSurveyQ = [
  { q: 'What do you use the pharmacy portal for most?',
    segs: [
      { label: 'Checking what a drug will cost', pct: 42 },
      { label: 'Refilling a prescription', pct: 31 },
      { label: 'Checking benefits or deductible', pct: 18 },
      { label: 'Something else', pct: 9 },
    ] },
  { q: 'What is the hardest part of managing your pharmacy benefit?',
    segs: [
      { label: 'Knowing what a drug will cost before I fill', pct: 46 },
      { label: 'Understanding my plan and deductible', pct: 24 },
      { label: 'Keeping track of refills', pct: 19 },
      { label: 'Finding an in-network pharmacy', pct: 11 },
    ] },
  { q: 'How do you decide where to fill a prescription?',
    segs: [
      { label: 'Whatever pharmacy is closest', pct: 38 },
      { label: 'The lowest price I can find', pct: 34 },
      { label: 'I always use the same pharmacy', pct: 21 },
      { label: 'Mail order', pct: 7 },
    ] },
];
const miPieColors = ['#6d28d9', '#12a3b4', '#f0932b', '#64748b'];
function miPiePaths(segs) {
  const cx = 90, cy = 90, r = 88;
  let a = -Math.PI / 2;
  return segs.map((s, i) => {
    const frac = s.pct / 100;
    const a2 = a + frac * Math.PI * 2;
    const x1 = (cx + r * Math.cos(a)).toFixed(2), y1 = (cy + r * Math.sin(a)).toFixed(2);
    const x2 = (cx + r * Math.cos(a2)).toFixed(2), y2 = (cy + r * Math.sin(a2)).toFixed(2);
    const large = frac > 0.5 ? 1 : 0;
    const d = segs.length === 1
      ? `M ${cx} ${cy - r} A ${r} ${r} 0 1 1 ${cx - 0.01} ${cy - r} Z`
      : `M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2} Z`;
    a = a2;
    return { d, color: miPieColors[i % miPieColors.length], pct: s.pct, label: s.label };
  });
}
const miSurveyCharts = miSurveyQ.map((item) => ({ ...item, paths: miPiePaths(item.segs) }));
