                  <span class="mi-survey-answer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>{it.a}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
        <div class="mi-survey-note">
          <p class="mi-survey-note-label">In their words &mdash; would you hire another designer to redesign the work?</p>
