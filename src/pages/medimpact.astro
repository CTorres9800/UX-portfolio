---
import CaseStudy from '../layouts/CaseStudy.astro';
import SectionHero from '../components/SectionHero.astro';
import SectionContent from '../components/SectionContent.astro';
import data from '../data/medimpact.json';

// Display order for the feature sections
const order = [
  'Dashboard',
  'My Prescriptions',
  'Drug Price Check',
  'Claims History',
  'Vaccine Module',
  'Open Enrollment',
  'Mobile Navigation',
];
const features = order
  .filter((k) => data[k])
  .map((k) => ({ name: k, ...data[k] }));

// Temporary hero image — full desktop Dashboard until a dedicated hero is chosen
const heroImg = '/images/medimpact/dashboard/desktop/desktop-hd.png';
---
<CaseStudy title="MedImpact">
  <SectionHero
    label="MEDIMPACT"
    title="A member portal for <strong>pharmacy benefits</strong>"
    image={heroImg}
    imageAlt="MedImpact member portal overview"
  />

  <SectionContent title="Overview">
    <div class="cs-body-text">
      <p><em>[Placeholder — MedImpact overview goes here.]</em> A responsive member portal for managing pharmacy benefits: checking drug prices, tracking prescriptions and claims, scheduling vaccines, and handling open enrollment — across desktop and mobile.</p>
    </div>
  </SectionContent>

  {features.map((f) => (
    <SectionContent title={f.name}>
      {f.desktop.length > 0 && (
        <div class="cs-subsection">
          <h3 class="cs-subsection-title">Desktop</h3>
          <div class="mi-shots">
            {f.desktop.map((img) => (
              <figure class="mi-shot">
                <img src={img.src} alt={img.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      )}
      {f.mobile.length > 0 && (
        <div class="cs-subsection">
          <h3 class="cs-subsection-title">Mobile</h3>
          <div class="mi-shots mi-shots--mobile">
            {f.mobile.map((img) => (
              <figure class="mi-shot mi-shot--mobile">
                <img src={img.src} alt={img.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      )}
    </SectionContent>
  ))}
</CaseStudy>
