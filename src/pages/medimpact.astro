---
import CaseStudy from '../layouts/CaseStudy.astro';
import SectionHero from '../components/SectionHero.astro';
import SectionAbout from '../components/SectionAbout.astro';
import SectionContent from '../components/SectionContent.astro';
import miData from '../data/medimpact.json';

const miOrder = ['Dashboard','My Prescriptions','Drug Price Check','Claims History','Vaccine Module','Open Enrollment','Mobile Navigation'];
const miFeatures = miOrder.filter((k) => miData[k]).map((k) => ({ name: k, ...miData[k] }));
const miShowcase = [
  { src: "/images/medimpact/dashboard/desktop/desktop-hd.png", title: "Dashboard", desc: "The dashboard shows to-do items, savings, and prescription status when a member logs in.", comment: "The most common next actions are placed on the first screen rather than behind navigation." },
  { src: "/images/medimpact/dashboard/desktop/dashboard-tab-to-do-next.png", title: "To Do Next", desc: "The To Do Next area lists tasks a member should handle, such as verifying an email, checking benefits, or setting up a refill.", comment: "Outstanding tasks are grouped in one place instead of scattered across the portal." },
  { src: "/images/medimpact/my-prescriptions/desktop/1-1-1-my-prescriptions.png", title: "My Prescriptions", desc: "Active prescriptions are listed with drug name, last fill date, pharmacy, and prescriber, along with refill and auto-refill status.", comment: "Refill status is shown inline so members do not need to open each prescription." },
  { src: "/images/medimpact/drug-price-check/desktop/frame-299.png", title: "Drug Price Check: Best Local Price", desc: "The Best Local Price tab lists nearby pharmacies and their price for the drug, with the lowest local price highlighted and shown on a map.", comment: "The three pricing views — Best Local Price, Mail Order Price, and Savings Calculator — sit under one set of tabs." },
  { src: "/images/medimpact/drug-price-check/desktop/mail-order-price.png", title: "Drug Price Check: Mail Order Price", desc: "The Mail Order Price tab shows the cost of filling the same drug through mail order.", comment: "Mail order uses the same layout as local pricing, so the two are easy to compare." },
  { src: "/images/medimpact/drug-price-check/desktop/savings-calculator.png", title: "Drug Price Check: Savings Calculator", desc: "The Savings Calculator tab estimates how much a member can save by adjusting the drug details or pharmacy.", comment: "Members can move between the three pricing views without leaving the page." },
  { src: "/images/medimpact/claims-history/desktop/claims-history-keyword-pills.png", title: "Claims History", desc: "Claims are listed and can be narrowed with filters, shown as removable keyword pills above the results.", comment: "Members can see and adjust exactly which filters are active." },
  { src: "/images/medimpact/vaccine-module/desktop/13.png", title: "Vaccine Module", desc: "The vaccine module lists recommended vaccines with eligibility and details, and lets members schedule one.", comment: "Clinical detail is written in plain language, with the option to read more." },
  { src: "/images/medimpact/open-enrollment/desktop/benefit-highlights.png", title: "Open Enrollment", desc: "Benefit highlights summarize what a plan covers during open enrollment.", comment: "The summary leads, with full detail available below it." },
  { src: "/images/medimpact/open-enrollment/desktop/benefit-highlights-comparison.png", title: "Plan Comparison", desc: "Plans are compared side by side across benefits and cost so members can see the differences in one view.", comment: "Plans are shown next to each other rather than one at a time." },
];
const miShowcaseSrcs = new Set(miShowcase.map((s) => s.src));
const miRest = miFeatures.map((f) => ({
  name: f.name,
  desktop: f.desktop.filter((img) => !miShowcaseSrcs.has(img.src)),
  mobile: f.mobile.filter((img) => !miShowcaseSrcs.has(img.src)),
}));
const miComponents = [
  { src: "/images/medimpact/dashboard/desktop/dashboard-settings.png", title: "Dashboard Customization", desc: "Members can control which widgets appear on the dashboard and in what order. Each widget can be shown or hidden and moved up or down.", bullets: ["Show or hide widgets such as Prescription Info, Benefit Info, and My Savings", "Reorder widgets with move up and move down", "Changes apply to the member's own dashboard"] },
  { src: "/images/medimpact/drug-price-check/desktop/map-expanded.png", title: "Pharmacy Price Map", desc: "The pharmacy map plots nearby pharmacies with their price for the selected drug, so members can compare cost and location at the same time. It can be expanded to full screen.", bullets: ["Each pharmacy pin shows its price for the drug", "Sortable by distance, with a location search", "Expands to full screen and stays in sync with the price list"] },
  { src: "/images/medimpact/claims-history/desktop/share-popup.png", title: "Share Claims History", desc: "Members can share their claims history by email invite or by link, and control what a recipient is able to do with it.", bullets: ["Invite someone by email, or copy a shareable link", "Set link access, such as view-only", "Used when a member needs to send records to a caregiver or provider"] },
  { src: "/images/medimpact/vaccine-module/desktop/next-steps-popup.png", title: "How To Get This Vaccine", desc: "For a recommended vaccine, this module explains how to get it, shows a nearby pharmacy with hours and contact details, and provides next-step actions.", bullets: ["Covers walk-in options and how to schedule", "Shows the nearest pharmacy with address, hours, and phone", "Actions include get directions, call a ride, and schedule an appointment"] },
  { src: "/images/medimpact/open-enrollment/desktop/popup-compare.png", title: "Plan Comparison Selector", desc: "During open enrollment, members select up to three plans to compare. Each plan card summarizes its deductible and pharmacy-benefit rules in plain language before it is added to the comparison.", bullets: ["Members can compare up to three plans at a time", "Each plan is summarized in plain language", "Selecting a plan adds it to the side-by-side comparison"] },
];
---

<CaseStudy title="MedImpact">

  <SectionHero
    label="MEDIMPACT"
    title="Designing the MedImpact member portal for <strong>desktop and mobile</strong>"
    image="/images/medimpact-hero.png"
    imageAlt="MedImpact member portal, desktop and mobile screens"
  />

  <SectionAbout
    label="ABOUT THE PROJECT"
    title="A member portal for pharmacy benefits"
    sidebar={[
      { label: 'ROLE', items: ['Senior UX Designer'] },
      { label: 'CLIENT', items: ['MedImpact'] },
      { label: 'AGENCY', items: ['Photon'] },
      { label: 'YEAR', items: ['2020'] },
    ]}
  >
    <p>MedImpact is one of the largest independent pharmacy benefit managers in the United States. Members use its portal to check drug prices, refill prescriptions, review claims, schedule vaccines, and choose a plan during open enrollment.</p>
    <p>I worked as a Senior UX Designer on this project through Photon, on a remote contract. I met with the product team every day and worked alongside product managers, researchers, visual designers, and developers throughout.</p>
    <p>The work covered the UX design of the portal: scoping and defining features, information architecture, design patterns, and task flows, along with the hi-fidelity mockups and UI specifications for desktop and mobile. I collected and analyzed user needs, worked with researchers to incorporate their findings, and reviewed work from other designers and the development team.</p>
    <p>The product is a prescription drug pricing platform, so a central goal was to show members what a drug would cost, across pharmacies, before they filled it.</p>
  </SectionAbout>

  <hr class="cs-section-divider">

  <SectionContent title="The Problem">
    <div class="cs-body-text">
      <p>A pharmacy plan involves cost, health information, and plan rules at the same time, which makes it easy for members to lose track of what matters to them. The design had to take that complexity and present it in a way that answered the member's immediate question.</p>
      <p>Three problems were central to the work.</p>
    </div>

    <div class="cs-problems-grid">
      <div class="cs-problem-card">
        <h3><span class="cs-x-icon"><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></svg></span> Problem 01: Costs were not shown before a prescription was filled</h3>
        <p>Members could not see what a medication would cost, or compare pharmacies and mail order, before filling. The cost appeared only after the transaction.</p>
      </div>
      <div class="cs-problem-card">
        <h3><span class="cs-x-icon"><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" /></svg></span> Problem 02: Prescription information was spread out</h3>
        <p>Refill status, auto-refill settings, and upcoming refills were located in different places. Members were often unsure what to reorder or when.</p>
      </div>
      <div class="cs-problem-card">
        <h3><span class="cs-x-icon"><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V7" /><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8" /><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z" /></svg></span> Problem 03: Claims and benefit details were hard to read</h3>
        <p>Claims history and benefit information used plan terminology and dense layouts, which made it difficult to answer basic questions such as what was paid and why.</p>
      </div>
    </div>

    <div class="cs-problem-item">
      <h3 class="cs-problem-title"><span class="cs-eyes-icon"><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 10h4" /><path d="M19 7V4a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v3" /><path d="M20 21a2 2 0 0 0 2-2v-3.851c0-1.39-2-2.962-2-4.829V8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v11a2 2 0 0 0 2 2z" /><path d="M 22 16 L 2 16" /><path d="M4 21a2 2 0 0 1-2-2v-3.851c0-1.39 2-2.962 2-4.829V8a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v11a2 2 0 0 1-2 2z" /><path d="M9 7V4a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v3" /></svg></span> What we observed</h3>
      <p>When members were unsure what something meant or what it would cost, they often contacted support instead of continuing in the portal. Reducing that uncertainty became a primary focus of the redesign.</p>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Design Requirements">
    <div class="cs-req-grid">
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8" /><path d="M12 18V6" /></svg>Show drug costs before the member fills</h3>
        <p>Members should be able to see plan-specific costs before filling a prescription, including a comparison across pharmacies and mail order.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 13v8" /><path d="M12 3v3" /><path d="M2.354 10.354a1.207 1.207 0 0 1 0-1.708l2.06-2.06A2 2 0 0 1 5.828 6h12.344a2 2 0 0 1 1.414.586l2.06 2.06a1.207 1.207 0 0 1 0 1.708l-2.06 2.06a2 2 0 0 1-1.414.586H5.828a2 2 0 0 1-1.414-.586z" /></svg>Lead with the most likely next action</h3>
        <p>The tasks a member is most likely to need should be visible first, rather than located behind menus.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" /><path d="M7 11h10" /><path d="M7 15h6" /><path d="M7 7h8" /></svg>Use plain language</h3>
        <p>Interface text should avoid plan jargon where possible and explain required terms clearly.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2" /><path d="M12 18h.01" /></svg>Design desktop and mobile together</h3>
        <p>Every task should function the same way on mobile as it does on desktop.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h.01" /><path d="M3 12h.01" /><path d="M3 19h.01" /><path d="M8 5h13" /><path d="M8 12h13" /><path d="M8 19h13" /></svg>Make dense information scannable</h3>
        <p>Claims, prescriptions, and price comparisons should be easy to sort, filter, and scan.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg>Present plan details openly</h3>
        <p>Disclaimers, coverage details, and plan status should be shown where they are relevant, rather than hidden.</p>
      </div>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="How I Worked">
    <div class="cs-body-text">
      <p>I worked as a Senior UX Designer through Photon, on a remote contract. I met with the product team every day and worked with product managers, researchers, visual designers, and developers throughout. Part of the role was reviewing work from the development team and other designers.</p>
      <p>Each area followed the same process: define the task, design it for desktop and mobile, review it with the team, and revise. Much of the work involved keeping plan logic &mdash; eligibility, pricing tiers, and coverage rules &mdash; accurate in the background while keeping the interface straightforward.</p>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Key Findings">
    <div class="cs-body-text">
      <p>The design was informed by the plan tasks themselves and by daily input from Photon's product team, who had visibility into where members had difficulty and what generated support calls. Several patterns were consistent:</p>
      <ul>
        <li>Not knowing a drug's cost in advance was the most common reason members hesitated.</li>
        <li>Information shown without explanation was more likely to prompt a support call than an action.</li>
        <li>Members tended to scan rather than read, so long blocks of plan text were often skipped.</li>
        <li>A significant portion of members used the portal only on mobile.</li>
      </ul>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Feature Prioritization">
    <div class="cs-body-text">
      <p>The portal covers a wide range of tasks, so the work was scoped around the tasks members use most and the data the plan could provide. Features were grouped as follows.</p>
    </div>
    <div class="cs-problems-grid">
      <div class="cs-problem-card cs-card--green">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>Must-have</h3>
        <ul>
          <li>Drug Price Check with plan-specific pricing</li>
          <li>My Prescriptions and refills in one place</li>
          <li>A dashboard focused on the next task</li>
          <li>Claims History with search and filters</li>
        </ul>
      </div>
      <div class="cs-problem-card cs-card--yellow">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>Nice-to-have</h3>
        <ul>
          <li>Vaccine recommendations and scheduling</li>
          <li>Savings calculator and mail-order comparison</li>
          <li>Dependent and profile switching</li>
        </ul>
      </div>
      <div class="cs-problem-card cs-card--red">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M4.929 4.929 19.07 19.071" /></svg>Not in this release</h3>
        <ul>
          <li>A full plan-selection wizard beyond benefit highlights</li>
          <li>Provider- or pharmacy-side tools</li>
          <li>Features that depended on data the plan could not yet provide</li>
        </ul>
      </div>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="The Solution">
    <div class="cs-body-text">
      <p>The redesign is organized around member tasks. Each area of the portal addresses a specific need.</p>
      <h3>Summary of changes</h3>
    </div>
    <div class="cs-problems-grid" style="margin-top: 24px;">
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="12" x="2" y="6" rx="2" /><circle cx="12" cy="12" r="2" /><path d="M6 12h.01M18 12h.01" /></svg>Drug price comparison</h3>
        <p>Drug Price Check displays plan-specific costs across pharmacies, with mail order and local pickup shown together, so members can compare before filling.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><path d="M12 11h4" /><path d="M12 16h4" /><path d="M8 11h.01" /><path d="M8 16h.01" /></svg>Consolidated prescriptions</h3>
        <p>Active prescriptions, refill status, and auto-refill settings are shown in one place.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" /></svg>Task-focused dashboard</h3>
        <p>The dashboard shows to-do items, savings, and prescription status on the first screen.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" /></svg>Searchable claims</h3>
        <p>Claims history can be filtered by drug, pharmacy, physician, and date, with active filters shown as removable pills.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 2 4 4" /><path d="m17 7 3-3" /><path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5" /><path d="m9 11 4 4" /><path d="m5 19-3 3" /><path d="m14 4 6 6" /></svg>Guided vaccine and enrollment flows</h3>
        <p>The vaccine and open enrollment modules were built as step-by-step flows.</p>
      </div>
      <div class="cs-problem-card">
        <h3><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="10" height="14" x="3" y="8" rx="2" /><path d="M5 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2h-2.4" /><path d="M8 18h.01" /></svg>Mobile parity</h3>
        <p>Each task was designed for mobile as well as desktop.</p>
      </div>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Stylized UI Components">
    {miComponents.map((c, i) => (
      <div class="cs-component-showcase" style={i > 0 ? 'margin-top: clamp(44px, 12vw, 120px);' : ''}>
        <div class="cs-component-details">
          <h3 class="cs-component-title">{c.title}</h3>
          <p class="cs-component-desc">{c.desc}</p>
          <h4>Key Details</h4>
          <ul>
            {c.bullets.map((b) => (<li>{b}</li>))}
          </ul>
        </div>
        <div class="cs-component-image">
          <img src={c.src} alt={c.title} class="cs-component-img mi-comp-img" loading="lazy" />
        </div>
      </div>
    ))}
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Hi Fi Designs">
    {miShowcase.map((s, i) => (
      <div class={i % 2 === 1 ? 'cs-hifi-showcase cs-hifi-showcase--reverse' : 'cs-hifi-showcase'} style={i > 0 ? 'margin-top: clamp(44px, 12vw, 120px);' : ''}>
        <div class="cs-hifi-image">
          <img src={s.src} alt={s.title} class="mi-hifi-img" style="max-width: 100%;" loading="lazy" />
        </div>
        <div class="cs-hifi-content">
          <h3 class="cs-hifi-title">{s.title}</h3>
          <p class="cs-hifi-desc">{s.desc}</p>
          <blockquote class="cs-hifi-quote">{s.comment}</blockquote>
        </div>
      </div>
    ))}

    <div class="mi-rest">
      {miRest.map((f) => (
        <div class="mi-group">
          <h3 class="cs-subsection-title">{f.name}</h3>
          {f.desktop.length > 0 && (
            <>
              <p class="mi-variant">Desktop</p>
              <div class="mi-shots">
                {f.desktop.map((img) => (
                  <figure class="mi-shot"><img src={img.src} alt={img.alt} loading="lazy" /></figure>
                ))}
              </div>
            </>
          )}
          {f.mobile.length > 0 && (
            <>
              <p class="mi-variant">Mobile</p>
              <div class="mi-shots mi-shots--mobile">
                {f.mobile.map((img) => (
                  <figure class="mi-shot mi-shot--mobile"><img src={img.src} alt={img.alt} loading="lazy" /></figure>
                ))}
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Testing & Validation">
    <div class="cs-body-text">
      <p>Screens were reviewed with Photon's team throughout the project rather than in a single round at the end. As flows were completed, they were checked against common member tasks such as pricing a drug, refilling a prescription, and reviewing a claim.</p>
      <p>The resulting changes were mostly related to clarity: some labels were rewritten in plainer language, some pricing states were given additional explanation, and a few steps were reordered so the next action was clearer.</p>
    </div>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Client Feedback">
    <div class="cs-body-text">
      <p>After the project, the product manager I worked with completed a client feedback survey and left a recommendation on my LinkedIn. All survey categories received the highest available rating. A selection is shown below.</p>
    </div>
    <div class="mi-ratings">
      <div class="mi-rating"><span class="mi-rating-value">Excellent</span><span class="mi-rating-label">Overall experience</span></div>
      <div class="mi-rating"><span class="mi-rating-value">Absolutely yes</span><span class="mi-rating-label">Would work together again</span></div>
      <div class="mi-rating"><span class="mi-rating-value">Extremely professional</span><span class="mi-rating-label">Professionalism</span></div>
      <div class="mi-rating"><span class="mi-rating-value">Amazing team player</span><span class="mi-rating-label">In a team environment</span></div>
      <div class="mi-rating"><span class="mi-rating-value">Better than others</span><span class="mi-rating-label">Compared to other designers</span></div>
      <div class="mi-rating"><span class="mi-rating-value">All of them</span><span class="mi-rating-label">In-scope UX/UI challenges solved</span></div>
    </div>
    <blockquote class="cs-pullquote">
      <svg class="cs-pullquote-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/></svg>
      The work done was thorough and meets our needs. I don't see a reason to have another designer to perform a redesign.
      <span class="mi-attr">Product Manager, Photon</span>
    </blockquote>
  </SectionContent>

  <hr class="cs-section-divider">

  <SectionContent title="Final Takeaways">
    <div class="cs-subsection">
      <h3 class="cs-subsection-title"><svg class="cs-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" /><path d="M22 10v6" /><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" /></svg>What I Learned</h3>
      <div class="cs-problems-grid cs-problems-grid--four">
        <div class="cs-problem-card">
          <svg class="cs-ico cs-ico--lead" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" /></svg>
          <p>Clear presentation of cost and plan information was the most important factor for members in this product.</p>
        </div>
        <div class="cs-problem-card">
          <svg class="cs-ico cs-ico--lead" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
          <p>Showing costs before a decision had a larger effect on the experience than any individual feature.</p>
        </div>
        <div class="cs-problem-card">
          <svg class="cs-ico cs-ico--lead" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3" /><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" /><path d="m21 3 1 11h-2" /><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" /><path d="M3 4h8" /></svg>
          <p>Meeting with the product team every day kept design and development aligned and reduced rework.</p>
        </div>
        <div class="cs-problem-card">
          <svg class="cs-ico cs-ico--lead" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8" /><path d="M10 19v-3.96 3.15" /><path d="M7 19h5" /><rect width="6" height="10" x="16" y="12" rx="2" /></svg>
          <p>Because many members used the portal only on mobile, mobile was treated as a primary target rather than a secondary one.</p>
        </div>
      </div>
    </div>
  </SectionContent>

</CaseStudy>
