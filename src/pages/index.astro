---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const homepage = await reader.singletons.homepage.read();

const data = homepage!;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <title>Christopher Torres, Product Designer & UX Strategy Coach</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    html { opacity: 0; }
    html.fonts-loaded { opacity: 1; transition: opacity .15s ease-in; }

    /* Paint the marker on the text itself so it cannot fall behind the hero. */
    .hero--home .highlight {
      background: linear-gradient(
        transparent 58%,
        rgba(246, 239, 168, .65) 58%,
        rgba(246, 239, 168, .65) 96%,
        transparent 96%
      );
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    .hero--home .highlight::after { content: none; }

    .hero-ninja-art {
      position: relative;
      width: min(340px, calc(100% - 40px));
      margin: 44px auto 0;
    }

    .hero-ninja-art .hero-ninja {
      display: block;
      width: 60%;
      max-height: none;
      animation: none;
    }

    .ninja-note {
      position: absolute;
      right: 0;
      width: 38%;
      margin: 0;
      color: #8a8a8a;
      font: italic 13px/1.5 var(--font-sans);
      letter-spacing: .01em;
    }

    .ninja-note--top {
      left: 56%;
      right: auto;
      top: 14%;
      width: 44%;
    }

    .ninja-note--top svg {
      position: absolute;
      right: calc(100% + 4px);
      top: 50%;
      transform: translateY(-50%);
      width: 36px;
      height: 18px;
      overflow: visible;
      fill: none;
      stroke: #a2a2a2;
      stroke-width: 1.15;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .ninja-note--bottom {
      left: 40%;
      right: auto;
      bottom: 12%;
      width: 60%;
    }

    .ninja-note--bottom span { display: block; white-space: nowrap; }

    @media (min-width: 1000px) {
      .hero.hero--home { grid-template-columns: minmax(0, 1fr) clamp(300px, 29vw, 350px); }
      .hero-ninja-art {
        width: 100%;
        margin: 0;
        animation: ninja-rise 3.5s cubic-bezier(.7, 0, .3, 1) .35s both;
      }
    }

    @media (max-width: 480px) {
      .ninja-note { font-size: 12px; }
      .ninja-note--top svg { width: 28px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-ninja-art { animation: none; }
    }
  </style>
  <script is:inline>document.fonts.ready.then(()=>document.documentElement.classList.add('fonts-loaded'));</script>
</head>
<body>

  <div id="site-header"></div>

  <!-- Hero -->
  <section id="about" class="hero hero--home">
    <div class="container">
      <h1>{data.heroHeadingBefore}<strong>{data.heroHeadingBold}</strong>{data.heroHeadingAfter}<span class="highlight">{data.heroHeadingHighlight}</span>{data.heroHeadingEnd}</h1>
      <p class="hero-sub">{data.heroDescription}</p>
      <a href="#work" class="hero-more">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
        View More
      </a>
    </div>
    <aside class="hero-ninja-art" aria-label="A playful ninja illustration">
      <img class="hero-ninja" src="/images/ninja-peek.png" alt="" aria-hidden="true" width="474" height="900">
      <p class="ninja-note ninja-note--top">
        That's not me.
        <svg viewBox="0 0 36 18" aria-hidden="true">
          <path d="M35 9C24 2 13 2 0 13M2 7l-2 6 6-1" />
        </svg>
      </p>
      <p class="ninja-note ninja-note--bottom">
        <span>I might be a unicorn,</span>
        <span>but I'm definitely not a ninja.</span>
      </p>
    </aside>
  </section>

  <!-- Work / Case Studies -->
  <section id="work" class="work">
    <div class="container">
      {data.caseStudies.map((study) => (
        <article class="case-study">
          <a href={study.link} class="case-study-image">
            <img src={study.image} alt={study.imageAlt}>
          </a>
          <div class="case-study-info">
            <h2>{study.title}</h2>
            <p>{study.description}</p>
            <a href={study.link} class="btn-outline">VIEW CASE STUDY</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Contact</h2>
        <p>
          <Fragment set:html={data.contactDescription.replace('Linkedin', '<a href="https://www.linkedin.com/in/christorres17/" target="_blank" rel="noopener" class="underline-link">Linkedin</a>')} />
        </p>
        <p class="contact-detail">{data.contactEmail}</p>
        <p class="contact-detail">{data.contactPhone}</p>
        <a href="/Christopher-Torres-Resume.pdf" target="_blank" rel="noopener" class="contact-detail download-link">Download Resume (PDF)</a>
      </div>
      <div class="contact-cta">
        <h2>{data.ctaHeading}</h2>
        <p>{data.ctaDescription}</p>
        <a href="https://tidycal.com/christopher-torres/15-minute-meeting" target="_blank" rel="noopener" class="underline-link">{data.ctaLinkText}</a>
      </div>
    </div>
  </section>

  <div id="site-footer"></div>

  <script is:inline src="/components.js"></script>
  <script is:inline>
    document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
    document.addEventListener('keydown', function(e) {
      if (e.ctrlKey || e.metaKey) {
        var k = e.key.toLowerCase();
        if (k === 'a' || k === 'c' || k === 'u' || k === 's' || k === 'p') {
          e.preventDefault();
        }
      }
      if (e.key === 'PrintScreen') { e.preventDefault(); }
    });
    document.addEventListener('dragstart', function(e) { e.preventDefault(); });
  </script>
</body>
</html>
